{
  "name": "lovely-talk",
  "private": true,
  "version": "1.0.0",
  "description": "러비러비톡 (Lovely Talk) - AI 캐릭터 대화 및 가상 커뮤니티 애플리케이션",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron release-windows server.js",
    "lint": "tsc --noEmit",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "version:verify": "node scripts/version-manager.mjs verify",
    "version:sync": "node scripts/version-manager.mjs sync",
    "version:bump": "node scripts/version-manager.mjs bump",
    "electron:compile": "node scripts/build-electron.mjs",
    "electron:dist:win": "npm run build && npm run electron:compile && electron-builder --win nsis --x64 --config electron-builder.config.cjs --publish never",
    "cap:sync": "npx cap sync android",
    "android:meta": "node scripts/generate-android-metadata.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@google/genai": "^3.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.11",
    "express": "^4.21.2",
    "idb": "^8.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.27.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
